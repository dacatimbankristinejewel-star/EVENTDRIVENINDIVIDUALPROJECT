<section class="page-section" id="page-rewards">
          <div class="section-title-row"><div><p class="eyebrow">CELEBRATE PROGRESS</p><h1>Rewards & recognition</h1><p class="subtitle">Make learning milestones visible and celebrate the people behind them.</p></div><button class="button button-primary" data-toast="Badge creation is ready to connect to your rewards settings."><svg><use href="#i-plus"/></svg> Create a badge</button></div>
          <div class="rewards-banner"><div class="banner-copy"><span>THIS MONTH'S MOMENTUM</span><h2>Small wins add up to big growth.</h2><p>Your learners have earned <strong>18,420 points</strong> so far this month. Keep the streak going.</p><button class="button button-white" data-toast="A celebration message is ready to share with your learners.">Celebrate your team <svg><use href="#i-arrow"/></svg></button></div><div class="banner-art"><div class="badge-orbit orbit-one"></div><div class="badge-orbit orbit-two"></div><div class="floating-badge badge-star">★</div><div class="floating-badge badge-flame">✦</div><div class="floating-badge badge-trophy">♛</div><div class="banner-center">✦</div></div></div>
          <div class="content-grid rewards-grid"><article class="panel leaderboard-panel"><div class="panel-heading"><div><h2>Top learners</h2><p>Leaderboard · November 2026</p></div><select class="select-control" aria-label="Leaderboard period"><option>This month</option><option>This quarter</option><option>All time</option></select></div>
            <div class="leader-row leader-head"><span>RANK</span><span>LEARNER</span><span>BADGES</span><span>POINTS</span></div>
            <div class="leader-row"><span class="rank rank-first">1</span><div class="table-person"><span class="avatar avatar-blue">SK</span><span><strong>Sofia Kim</strong><small>Technology</small></span></div><span class="badge-count">🏅 12</span><strong>4,280</strong></div>
            <div class="leader-row"><span class="rank rank-second">2</span><div class="table-person"><span class="avatar avatar-teal">AC</span><span><strong>Amara Cole</strong><small>People & Culture</small></span></div><span class="badge-count">🏅 9</span><strong>2,840</strong></div>
            <div class="leader-row"><span class="rank rank-third">3</span><div class="table-person"><span class="avatar avatar-lilac">PR</span><span><strong>Priya Raman</strong><small>Customer Experience</small></span></div><span class="badge-count">🏅 8</span><strong>2,310</strong></div>
            <div class="leader-row"><span class="rank">4</span><div class="table-person"><span class="avatar avatar-coral">JM</span><span><strong>Jonah Mitchell</strong><small>Operations</small></span></div><span class="badge-count">🏅 6</span><strong>1,620</strong></div>
            <div class="leader-row"><span class="rank">5</span><div class="table-person"><span class="avatar avatar-gold">EB</span><span><strong>Ethan Brooks</strong><small>Finance</small></span></div><span class="badge-count">🏅 4</span><strong>940</strong></div>
          </article>
            <article class="panel badges-panel"><div class="panel-heading"><div><h2>Achievement badges</h2><p>Earned milestones from your programs</p></div><button class="more-button" data-toast="Badge library opened.">Badge library <svg><use href="#i-arrow"/></svg></button></div><div class="badge-collection">
              <div class="achievement"><span class="achievement-icon achievement-gold">✦</span><strong>Fast Starter</strong><small>First course completed</small><b>482 earned</b></div>
              <div class="achievement"><span class="achievement-icon achievement-purple">♛</span><strong>Knowledge Pro</strong><small>Assessment ace · 90%+</small><b>214 earned</b></div>
              <div class="achievement"><span class="achievement-icon achievement-teal">↗</span><strong>On a Roll</strong><small>7-day learning streak</small><b>168 earned</b></div>
              <div class="achievement"><span class="achievement-icon achievement-coral">★</span><strong>Safety Champion</strong><small>All safety courses done</small><b>326 earned</b></div>
            </div></article>
          </div>
          {{> certificate}}
        </section>
