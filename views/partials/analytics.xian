<section class="page-section" id="page-analytics">
          <div class="section-title-row"><div><p class="eyebrow">INSIGHTS CENTER</p><h1>Analytics & reports</h1><p class="subtitle">Turn learner activity into clear, actionable decisions.</p></div><button class="button button-primary" id="analyticsExport"><svg><use href="#i-download"/></svg> Export report</button></div>
          <div class="report-filter-row"><div class="filter-pills" id="reportFilters"><button class="filter-pill selected" data-filter="30">Last 30 days</button><button class="filter-pill" data-filter="90">90 days</button><button class="filter-pill" data-filter="365">This year</button></div><span class="data-note"><i class="live-dot"></i> Updated just now</span></div>
          <div class="stat-grid analytics-stats">
            <article class="stat-card"><div class="stat-top"><span>Overall completion</span><span class="stat-icon icon-mint"><svg><use href="#i-check"/></svg></span></div><div class="stat-value">78.4<span class="unit">%</span></div><div class="stat-foot"><span class="trend-up">↗ 6.2%</span><span>vs. previous period</span></div></article>
            <article class="stat-card"><div class="stat-top"><span>Avg. assessment score</span><span class="stat-icon icon-lilac"><svg><use href="#i-chart"/></svg></span></div><div class="stat-value">84<span class="unit">%</span></div><div class="stat-foot"><span class="trend-up">↗ 2.4%</span><span>across all courses</span></div></article>
            <article class="stat-card"><div class="stat-top"><span>At-risk learners</span><span class="stat-icon icon-peach"><svg><use href="#i-users"/></svg></span></div><div class="stat-value">126</div><div class="stat-foot"><span class="trend-warn">Needs attention</span><span>5.1% of active learners</span></div></article>
            <article class="stat-card"><div class="stat-top"><span>Compliance completion</span><span class="stat-icon icon-sky"><svg><use href="#i-award"/></svg></span></div><div class="stat-value">94.2<span class="unit">%</span></div><div class="stat-foot"><span class="trend-up">↗ 3.8%</span><span>2,342 of 2,486 learners</span></div></article>
          </div>
          <div class="content-grid analytics-grid">
            <article class="panel wide-panel"><div class="panel-heading"><div><h2>Completion by department</h2><p>Course progress across your organization</p></div><span class="subtle-tag">30-day view</span></div><div class="department-chart">
              <div class="department-row"><div class="department-label"><strong>People & Culture</strong><span>342 learners</span></div><div class="department-bar"><i style="width:88%;background:#7265e8"></i></div><b>88%</b></div>
              <div class="department-row"><div class="department-label"><strong>Operations</strong><span>584 learners</span></div><div class="department-bar"><i style="width:81%;background:#7f73eb"></i></div><b>81%</b></div>
              <div class="department-row"><div class="department-label"><strong>Customer Experience</strong><span>416 learners</span></div><div class="department-bar"><i style="width:76%;background:#91a7f2"></i></div><b>76%</b></div>
              <div class="department-row"><div class="department-label"><strong>Technology</strong><span>628 learners</span></div><div class="department-bar"><i style="width:72%;background:#a1b7ed"></i></div><b>72%</b></div>
              <div class="department-row"><div class="department-label"><strong>Finance</strong><span>298 learners</span></div><div class="department-bar"><i style="width:66%;background:#f0a77d"></i></div><b>66%</b></div>
            </div></article>
            <article class="panel skills-panel"><div class="panel-heading"><div><h2>Skill gaps to watch</h2><p>Topics with the lowest assessment scores</p></div><span class="risk-tag">3 focus areas</span></div>
              <div class="skill-gap-row"><div class="skill-gap-head"><span>Data handling</span><b>58% avg. score</b></div><div class="skill-gap-track"><i style="width:58%"></i></div><small>32% of learners need a refresher</small></div>
              <div class="skill-gap-row"><div class="skill-gap-head"><span>Incident response</span><b>64% avg. score</b></div><div class="skill-gap-track"><i style="width:64%"></i></div><small>24% of learners need a refresher</small></div>
              <div class="skill-gap-row"><div class="skill-gap-head"><span>Phishing awareness</span><b>69% avg. score</b></div><div class="skill-gap-track"><i style="width:69%"></i></div><small>18% of learners need a refresher</small></div>
              <button class="button button-outline full-button" data-toast="A targeted learning plan has been added to your drafts.">Create learning plan <svg><use href="#i-arrow"/></svg></button>
            </article>
          </div>
          <article class="panel table-panel"><div class="panel-heading"><div><h2>Compliance reports</h2><p>Official completion records for required training</p></div><div class="table-actions"><select class="select-control" aria-label="Compliance course"><option>All required courses</option><option>Workplace Safety Essentials</option><option>Data Privacy & Protection</option></select><button class="button button-outline button-small" id="complianceExport"><svg><use href="#i-download"/></svg> Download CSV</button></div></div>
            <div class="table-scroll"><table><thead><tr><th>REQUIRED COURSE</th><th>ASSIGNED</th><th>COMPLETED</th><th>OVERDUE</th><th>COMPLIANCE</th><th>REPORT</th></tr></thead><tbody>
              <tr><td><strong>Workplace Safety Essentials</strong></td><td>2,486</td><td>2,401</td><td><span class="status-text status-warn">85 learners</span></td><td><span class="status-badge badge-green">96.6%</span></td><td><button class="row-action report-download" data-report="Workplace Safety Essentials">Download</button></td></tr>
              <tr><td><strong>Data Privacy & Protection</strong></td><td>2,486</td><td>2,342</td><td><span class="status-text status-warn">144 learners</span></td><td><span class="status-badge badge-amber">94.2%</span></td><td><button class="row-action report-download" data-report="Data Privacy & Protection">Download</button></td></tr>
              <tr><td><strong>Code of Conduct</strong></td><td>2,486</td><td>2,463</td><td><span class="status-text status-green">23 learners</span></td><td><span class="status-badge badge-green">99.1%</span></td><td><button class="row-action report-download" data-report="Code of Conduct">Download</button></td></tr>
            </tbody></table></div>
          </article>
        </section>
