<section class="page-section" id="page-courses">
          <div class="section-title-row"><div><p class="eyebrow">LEARNING LIBRARY</p><h1>Course catalog</h1><p class="subtitle">Discover, assign, and manage learning across your organization.</p></div><button class="button button-primary" data-toast="Course creation is ready to connect to your content workflow."><svg><use href="#i-plus"/></svg> Create a course</button></div>
